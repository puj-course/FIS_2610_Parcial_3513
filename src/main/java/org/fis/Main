import java.util.Scanner;
import java.time.LocalDateTime;

public class Main {

    public static void main(String[] args) {

        Scanner scanner = new Scanner(System.in);

        Reclamo reclamo = registrarReclamo(scanner);

        System.out.println("\nReclamo registrado correctamente:");
        System.out.println(reclamo);

        scanner.close();
    }

    public static Reclamo registrarReclamo(Scanner scanner) {
        
        //Crear un nuevo reclamo y solicitar al usuario que ingrese los datos necesarios
        Reclamo reclamo = new Reclamo();

        System.out.println("Registrar Reclamo");

        System.out.print("Ingrese ID del reclamo: ");
        reclamo.setIdReclamo(scanner.nextInt());
        scanner.nextLine();

        System.out.print("Tipo (Reclamacion / Incidente): ");
        reclamo.setTipo(scanner.nextLine());

        System.out.print("Descripcion del reclamo: ");
        reclamo.setDescripcion(scanner.nextLine());

        reclamo.setFechaRegistro(LocalDateTime.now());

        System.out.print("Estado (Pendiente / En revision / Resuelto): ");
        reclamo.setEstado(scanner.nextLine());

        System.out.print("ID de la mesa: ");
        reclamo.setIdMesa(scanner.nextInt());

        System.out.print("ID del puesto de votacion: ");
        reclamo.setIdPuestoVotacion(scanner.nextInt());
        scanner.nextLine();

        System.out.print("Nombre del partido: ");
        reclamo.setNombrePartido(scanner.nextLine());

        System.out.print("Nombre del testigo: ");
        reclamo.setNombreTestigo(scanner.nextLine());

        return reclamo;
    }
}